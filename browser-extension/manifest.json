{
  "manifest_version": 3,
  "name": "APTOGON Verified Human",
  "version": "0.3.2",
  "description": "Show a verified-human badge next to your profile on supported sites. Gesture-verified DID on Aptos, no email required.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aptogon@homosapience.org",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://homosapience.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://www.reddit.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*",
        "https://www.youtube.com/*",
        "https://www.instagram.com/*",
        "https://substack.com/*",
        "https://news.ycombinator.com/*",
        "https://stackoverflow.com/*",
        "https://discord.com/*",
        "https://web.telegram.org/*",
        "https://habr.com/*",
        "https://bsky.app/*",
        "https://www.facebook.com/*",
        "https://www.tiktok.com/*",
        "https://www.pinterest.com/*",
        "https://medium.com/*",
        "https://dev.to/*",
        "https://gitlab.com/*",
        "https://www.twitch.tv/*",
        "https://www.quora.com/*",
        "https://web.whatsapp.com/*",
        "https://www.notion.so/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "badge.svg"
      ],
      "matches": [
        "https://github.com/*",
        "https://www.reddit.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*",
        "https://www.youtube.com/*",
        "https://www.instagram.com/*",
        "https://substack.com/*",
        "https://news.ycombinator.com/*",
        "https://stackoverflow.com/*",
        "https://discord.com/*",
        "https://web.telegram.org/*",
        "https://habr.com/*",
        "https://bsky.app/*",
        "https://www.facebook.com/*",
        "https://www.tiktok.com/*",
        "https://www.pinterest.com/*",
        "https://medium.com/*",
        "https://dev.to/*",
        "https://gitlab.com/*",
        "https://www.twitch.tv/*",
        "https://www.quora.com/*",
        "https://web.whatsapp.com/*",
        "https://www.notion.so/*"
      ]
    }
  ]
}
