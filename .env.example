# APTOGON v0.2.0 — единый файл конфигурации
# Скопируй: cp .env.example .env

# ── AI Provider (SapiX inference engine) ─────────────────────
#
# ★ GONKA (рекомендуется) — децентрализованная сеть GPU
#   Фаза 1 — GonkaGate (Bearer auth, USD биллинг):
#     GONKA_PROVIDER=gonka
#     GONKA_BASE_URL=https://api.gonkagate.com/v1
#     GONKA_API_KEY=<ключ с gonkagate.com/en/register>
#
#   Фаза 3 — Direct Gonka (wallet auth, GNK токены):
#     ⚠️  Требует GNK баланс — фaucet отсутствует, GNK не листингован на биржах (май 2026)
#     ⚠️  Для новых кошельков нужна публикация pubkey on-chain (inferenced tx gonka publish-pubkey)
#     GONKA_PROVIDER=gonka_direct
#     GONKA_BASE_URL=https://node4.gonka.ai
#     GONKA_PRIVATE_KEY=<hex privkey из inferenced keys export ... --unarmored-hex --unsafe --yes>
#     GONKA_ADDRESS=<gonka1... адрес>
#
# OpenRouter (fallback): GONKA_PROVIDER=openrouter  https://openrouter.ai/api/v1
# Together.ai:           GONKA_PROVIDER=together    https://api.together.xyz/v1
# Ollama (локально):     GONKA_PROVIDER=ollama      http://localhost:11434/v1

GONKA_PROVIDER=openrouter
GONKA_API_KEY=sk-or-v1-your-key-here
GONKA_BASE_URL=https://openrouter.ai/api/v1
GONKA_FALLBACK=true

# Gonka Direct (Фаза 3 — заполнить при переходе на GNK биллинг)
GONKA_PRIVATE_KEY=
GONKA_ADDRESS=

# ── Aptos Blockchain ──────────────────────────────────────────
# Без APTOS_PRIVATE_KEY → работает local store (MVP режим)
APTOS_NODE_URL=https://fullnode.testnet.aptoslabs.com/v1
APTOS_PRIVATE_KEY=
APTOS_NETWORK=testnet
APTOGON_CONTRACT=0x1

# ── Redis ─────────────────────────────────────────────────────
# Бесплатный хостинг: https://upstash.com
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ────────────────────────────────────────────────
# JWT_SECRET: any high-entropy random string (>=32 bytes recommended)
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL=3600

# ── Web Push (VAPID) ──────────────────────────────────────────
# Generate with: python backend/generate_vapid_keys.py
# VAPID_PRIVATE_KEY is a single-line PEM with \n escapes
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── Aptos signer (optional, only if APTOS_PRIVATE_KEY set) ────
APTOS_SIGNER_ADDRESS=

# ── Gonka fallback (optional) ─────────────────────────────────
GONKA_OPENROUTER_URL=https://openrouter.ai/api/v1

# ── App ───────────────────────────────────────────────────────
HSI_ENV=development
